class Main {

    static int countPairs(int[] a, int l, int mid, int r) {

        int j = mid + 1;
        int count = 0;

        for (int i = l; i <= mid; i++) {

            while (j <= r &&
                   (long)a[i] > 2L * a[j]) {
                j++;
            }

            count += j - (mid + 1);
        }

        return count;
    }

    static int mergeSort(int[] a, int l, int r) {

        if (l >= r)
            return 0;

        int mid = (l + r) / 2;

        int count = mergeSort(a, l, mid);
        count += mergeSort(a, mid + 1, r);

        count += countPairs(a, l, mid, r);

        merge(a, l, mid, r);

        return count;
    }

    static void merge(int[] a, int l, int mid, int r) {

        int[] temp = new int[r - l + 1];

        int i = l;
        int j = mid + 1;
        int k = 0;

        while (i <= mid && j <= r) {

            if (a[i] <= a[j])
                temp[k++] = a[i++];
            else
                temp[k++] = a[j++];
        }

        while (i <= mid)
            temp[k++] = a[i++];

        while (j <= r)
            temp[k++] = a[j++];

        for (i = l; i <= r; i++)
            a[i] = temp[i - l];
    }
}

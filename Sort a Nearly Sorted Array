import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n];

        for (int i = 0; i < n; i++)
            a[i] = sc.nextInt();

        int k = sc.nextInt();

        PriorityQueue<Integer> pq = new PriorityQueue<>();

        for (int i = 0; i < n; i++) {

            pq.add(a[i]);

            if (pq.size() > k) {
                System.out.print(pq.poll() + " ");
            }
        }

        while (!pq.isEmpty())
            System.out.print(pq.poll() + " ");
    }
}

class Solution {
    public int splitArray(int[] nums, int k) {

        long left = 0;
        long right = 0;

        for (int x : nums) {
            left = Math.max(left, x);
            right += x;
        }

        while (left < right) {

            long mid = left + (right - left) / 2;

            int parts = 1;
            long sum = 0;

            for (int x : nums) {

                if (sum + x > mid) {
                    parts++;
                    sum = x;
                } else {
                    sum += x;
                }
            }

            if (parts <= k) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }

        return (int) left;
    }
}

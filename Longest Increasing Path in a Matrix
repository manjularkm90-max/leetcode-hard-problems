class Solution {
    int[][] matrix;
    int[][] dp;
    int m, n;

    public int longestIncreasingPath(int[][] matrix) {
        this.matrix = matrix;

        m = matrix.length;
        n = matrix[0].length;

        dp = new int[m][n];

        int ans = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                ans = Math.max(ans, dfs(i, j));
            }
        }

        return ans;
    }

    private int dfs(int i, int j) {

        if (dp[i][j] != 0) {
            return dp[i][j];
        }

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        int best = 1;

        for (int d = 0; d < 4; d++) {

            int ni = i + dr[d];
            int nj = j + dc[d];

            if (ni >= 0 && ni < m &&
                nj >= 0 && nj < n &&
                matrix[ni][nj] > matrix[i][j]) {

                best = Math.max(
                    best,
                    1 + dfs(ni, nj)
                );
            }
        }

        dp[i][j] = best;

        return best;
    }
}
